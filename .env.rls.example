# =============================================================================
# ENV-GATED RLS / SECURITY INTEGRATION TEST SUITE  (P3.11)
# =============================================================================
#
#  !!!  READ THIS BEFORE YOU SET ANYTHING  !!!
#
#  This suite runs REAL SQL against a REAL Supabase project. It CREATES and
#  DESTROYS auth users, workspaces, properties, units, vendors, tickets,
#  comments, events, tokens and storage objects on every run.
#
#  >>> USE A SEPARATE, DISPOSABLE SUPABASE PROJECT. <<<
#  >>> NEVER POINT THESE AT PRODUCTION (OR ANY DB WITH REAL DATA).  <<<
#
#  A run that fails midway may leave orphaned users/workspaces; teardown is
#  best-effort. Only ever aim this at a throwaway project you can wipe.
#
#  The project must have migrations 0001–0015 applied (all the RLS lives there)
#  and a Storage bucket named `attachments` (for the storage suite).
#
# -----------------------------------------------------------------------------
# To run:
#   1. Copy this file to `.env.rls` (gitignored) OR export these in your shell.
#   2. npm run test:rls
#
# With NONE of these set, `npm run test:rls` SKIPS every suite and exits 0.
# The default `npm run test` NEVER touches these files or vars.
# =============================================================================

# Project URL, e.g. https://abcdefgh.supabase.co  (Settings > API)
RLS_TEST_SUPABASE_URL=

# service_role secret key — bypasses RLS. Server-side only. Disposable project only!
RLS_TEST_SERVICE_ROLE_KEY=

# anon / publishable key — used to sign users in so their queries run under RLS.
RLS_TEST_ANON_KEY=
