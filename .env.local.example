NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications (Phase 4) — DISCONNECTED BY DEFAULT.
# Leave RESEND_API_KEY unset and sendEmail() is a no-op that only logs to the
# console (zero network calls, zero cost). Set both to send real email via the
# Resend REST API. EMAIL_FROM must be a Resend-verified sender.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=Property Ops <ops@yourdomain.com>

# Invite-only signup (S1.2) — unset = open public signup (pre-S1 default).
# Set to "invite" to close /signup and require admin-issued invites instead.
# SIGNUP_MODE=invite

# AI ticket triage (disconnected integration) — unset = offline heuristic classifier only.
# Set both to enable real Claude-based triage via raw fetch (no SDK).
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5

# Public demo sandbox (Track D) — leave unset on a self-host serving real tenant data.
# DEMO_MODE=on enables "Explore the demo" entry points; DEMO_WORKSPACE_ID must match
# the fixed UUID seeded by migration 0023_demo_mode.sql's reset_demo_workspace().
# DEMO_MODE=on
# DEMO_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
